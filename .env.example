# Production site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (server-side only; never prefix with NEXT_PUBLIC_)
# Any HTTPS endpoint that accepts a JSON POST: Formspree, Make, Zapier, n8n, your own API...
CONTACT_WEBHOOK_URL=
# Optional bearer token sent to the webhook
CONTACT_WEBHOOK_TOKEN=
